# Ignore everything unless the public package explicitly allows it.
*
!.gitignore
!README.md
!README.zh-CN.md
!LICENSE
!CHANGELOG.md
!skills/
!skills/**/
!skills/**/*.md
!skills/**/*.py
!skills/**/*.js
!skills/**/*.css
!skills/**/*.html
!skills/**/*.yaml
!skills/**/LICENSE
!tests/
!tests/*.py
!tests/*.cjs
!docs/
!docs/*.md
!demo/
!demo/sample.json
!demo/overview.jpg
!demo/expenses-zh.jpg
!demo/expenses-en.jpg
!demo/README.md
!scripts/
!scripts/*.py
!scripts/*.sh
__pycache__/
*.pyc
.DS_Store
